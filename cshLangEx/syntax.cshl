var int x = 10

func hello() { # barebones func syntax
	print("Hello, World!")
}

if x > 10 {}

func greet(name: str) -> undefined { # function syntax
	print(f"Hello, {name}!")
}

func add(a: int, b: int) -> int {
	return a + b
}

# Comment

// Multi-
   Line
   Comment
\\

func wrapper(func: Function) -> Function {
	func logger() {
		print(f"Running: {func.name}")
		func()
		print(f"Completed: {func.name}")
	}

	return logger
}


func@wrapper typewriterPrint(*args: str, sep: str = " ", end: str = "\n") -> undefined {} # wrapper syntax

() -> undefined => {
	print(f"Hello, World!")
}) # lambda syntax