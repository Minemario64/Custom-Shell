class CommandStdinBuf:
    def read(self, amount: int = -1) -> bytes: ...
    def readline(self, limit: int = -1) -> bytes: ...

class CommandStdoutBuf:
    def write(self, s: str | bytes) -> None: ...
    def flush(self) -> None: ...

def getStdout() -> CommandStdoutBuf: ...
def getStdin() -> CommandStdinBuf: ...